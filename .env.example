# Trak Assessoria — exemplo de variáveis de ambiente
# Copie para .env.local e preencha com valores reais.
CONTACT_EMAIL=seu-email@exemplo.com
RESEND_API_KEY=re_xxx
# Opcional: remetente verificado no Resend (padrão: onboarding@resend.dev).
# Sem domínio próprio, use o remetente padrão do Resend ou o e-mail verificado na conta.
RESEND_FROM=Trak Assessoria <onboarding@resend.dev>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Analytics opcional (Fase 5.5) — privacy-first, ativado só com consentimento LGPD.
# Deixe NEXT_PUBLIC_ANALYTICS vazio (ou ausente) para desativar completamente.
# NEXT_PUBLIC_ANALYTICS=plausible
# NEXT_PUBLIC_ANALYTICS_DOMAIN=seu-dominio.com.br
# Opcional: URL do script do provider (padrão: Plausible SaaS). Use para
# self-hosted (ex.: https://stats.seu-dominio.com.br/js/script.js).
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
